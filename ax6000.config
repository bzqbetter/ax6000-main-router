# Redmi AX6000 (MTK U-Boot layout) — main router seed config
# Source: chasey-dev/immortalwrt-mt798x-rebase, branch 25.12
# Role: main router 192.168.5.1, hardware NAT on; proxy normally runs on the
#       UTM side router, HomeProxy/OpenClash here are a fallback.
# Usage: cp ax6000.config .config && make defconfig

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-mtkuboot=y

CONFIG_DEVEL=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_BLKID=y
CONFIG_BUSYBOX_CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_BUSYBOX_CONFIG_VOLUMEID=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_PKG_FORTIFY_SOURCE_2=y

# ---- MTK platform: closed-source WiFi + WiFi offload (warp) ----
CONFIG_PACKAGE_kmod-conninfra=y
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_mtk-smp=y
CONFIG_PACKAGE_eip197-mini-firmware=y
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
CONFIG_PACKAGE_datconf=y
CONFIG_PACKAGE_ucode-mod-datconf=y
CONFIG_PACKAGE_l1util=y
CONFIG_PACKAGE_ucode-mod-l1parser=y
CONFIG_PACKAGE_kvcedit=y
CONFIG_PACKAGE_libkvcutil=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_mtwifi-cfg-ucode=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iwinfo-ucode=y

# ---- Hardware NAT + acceleration UI (turboacc-mtk) ----
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_hnat-detect=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
# CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING is not set
CONFIG_PACKAGE_TURBOACC_INCLUDE_NO_FASTPATH=y

# ---- Per-device speed limit on hardware QoS (eqos-mtk), replaces SQM ----
CONFIG_PACKAGE_luci-app-eqos-mtk=y
CONFIG_PACKAGE_luci-i18n-eqos-mtk-zh-cn=y
CONFIG_PACKAGE_mtkhqos_util=y

# ---- Network / firewall ----
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
# IPv6 not used: no DHCPv6 client/server, no IPv6 LuCI protocol
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_odhcpd is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_ppp-mod-pppoe_IPV6 is not set
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ---- Proxy (fallback when side router is off) ----
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_luci-app-openclash=y
# Ruby JIT pulls in the host Rust toolchain (fails to build, not needed by OpenClash)
# CONFIG_RUBY_ENABLE_YJIT is not set
# sing-box from packages master: NaiveProxy outbound needs libcronet (not in 25.12 feed)
# CONFIG_SING_BOX_BUILD_NAIVE_OUTBOUND is not set
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_unzip=y

# ---- LuCI ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_default-settings-chn=y

# ---- System ----
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_htop=y

# ---- Dropped vs. current firmware ----
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_sqm-scripts is not set
# CONFIG_PACKAGE_https-dns-proxy is not set
